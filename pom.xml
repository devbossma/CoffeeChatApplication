<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
    <!-- Latest stable GA as of this writing; 4.2.0-M1 exists but is a milestone, not used here. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.saberlabs</groupId>
    <artifactId>coffee-chat-application</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>CoffeeChatApplication</name>
    <description>Not So Simple Chat: the coffee shop chat application, reimplemented on Spring Boot</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Part 01/03: REST controllers for order placement and chat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Part 03: chat/order persistence via Spring Data JPA repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation for REST request DTOs (order placement, chat messages) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- /actuator/health: basic liveness check while the app has no UI of its own -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.postgresql/postgresql -->
        <!-- JDBC driver behind Spring Data JPA; version is managed by the parent's dependency-management. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Local dev convenience only (auto-restart on classpath change); excluded from the built jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.jetbrains/annotations -->
        <!-- @NotNull / @Nullable, same convention MyDesignPattern uses throughout. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Part 04: JUnit 5 + Mockito, bundled by spring-boot-starter-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Part 01/03: the @WebMvcTest / MockMvc slice. Spring Boot 4 split this out of
             spring-boot-starter-test into its own module; version managed by the parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Part 04: @DataJpaTest / @SpringBootTest against a real Postgres container,
             not an in-memory stand-in. spring-boot-testcontainers' version comes from the
             parent's dependency-management. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/org.testcontainers/junit-jupiter -->
        <!-- Testcontainers itself split into a differently-versioned "testcontainers"/
             "testcontainers-bom" 2.0.x line while junit-jupiter and postgresql are still on
             the 1.21.x line; the parent's BOM doesn't cover these two yet, hence the explicit,
             matching version below instead of a second BOM import. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Source: https://mvnrepository.com/artifact/org.jacoco/jacoco-maven-plugin -->
            <!-- Coverage gate, same tool and same rule MyDesignPattern uses: mvn verify fails
                 the build if any package's line coverage drops below 80%. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Rule-level <excludes> only applies when <element> is CLASS, so
                                 for a PACKAGE-element rule the exclusion has to live here instead
                                 (same reasoning as MyDesignPattern's pom.xml). Only the app entry
                                 point is excluded so far, since it's just SpringApplication.run(...)
                                 and not meaningfully unit-testable; add to this list only for
                                 genuinely untestable wiring, never to paper over a real gap. -->
                            <excludes>
                                <exclude>dev/saberlabs/coffeechat/CoffeeChatApplication.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
